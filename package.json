{
  "name": "infinite-numeral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vue-tsc && vite build",
    "build:pwa": "vue-tsc && vite build",
    "build:electron": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "electron": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "break_eternity.js": "^2.0.0",
    "dexie": "^4.0.0",
    "he": "^1.2.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.infinite-numeral.app",
    "productName": "无限数域",
    "directories": {
      "output": "out"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "artifactName": "${productName}.exe"
    },
    "forceCodeSigning": false
  }
}
